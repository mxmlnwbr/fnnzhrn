# Required: the app only opens for signed-in users (see README → "Sign-in and sync").
# Without DATABASE_URL, BETTER_AUTH_SECRET and RESEND_API_KEY it stays locked on the sign-in screen.

# Neon connection string (the pooled one, host ending in -pooler). Vercel's Neon integration sets it.
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The app's public URL, used in the links in emails. Leave unset to use the URL each request came in on.
BETTER_AUTH_URL=http://localhost:3000

# Sends the confirmation and password-reset emails (resend.com, free tier).
RESEND_API_KEY=re_...
# Sender address on a domain verified in Resend. Without it, Resend's test sender is used,
# which only delivers to the email address of your Resend account.
EMAIL_FROM=fnnzhrn <login@fnnzhrn.ch>
